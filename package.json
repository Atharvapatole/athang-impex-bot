{
  "name": "athang-impex-chatbot-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-prisma.js && next dev -p 3000",
    "build": "node scripts/prepare-prisma.js && prisma generate && next build",
    "postinstall": "node scripts/prepare-prisma.js && prisma generate",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:migrate:deploy": "node scripts/prepare-prisma.js && prisma migrate deploy",
    "db:migrate:status": "node scripts/prepare-prisma.js && prisma migrate status",
    "db:push": "node scripts/prepare-prisma.js && prisma db push",
    "db:generate": "node scripts/prepare-prisma.js && prisma generate",
    "db:bootstrap": "node scripts/bootstrap-cli.js",
    "db:seed": "node scripts/prepare-prisma.js && node prisma/seed.js",
    "db:setup": "node scripts/prepare-prisma.js && prisma migrate deploy && node scripts/bootstrap-cli.js",
    "worker": "node scripts/worker.js",
    "test": "node --test tests/suite.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "14.2.20",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

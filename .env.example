# Database connection string
# For local prototyping & test: file:./dev.db (SQLite)
# For production PostgreSQL: postgresql://postgres:postgres@localhost:5432/chatbot_platform?schema=public
DATABASE_URL="file:./dev.db"

# Master Encryption Key (32 bytes as 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# JWT Secret for Session Authentication
JWT_SECRET="replace-with-a-very-secure-random-secret-at-least-32-chars-long"

# Application Environment
# Local development: APP_BASE_URL="http://localhost:3000"
# Production (Vercel): APP_BASE_URL="https://athangimpexbot.vercel.app"
NODE_ENV="production"
PORT=3000
APP_BASE_URL="https://athangimpexbot.vercel.app"

# Rate Limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SEC=900

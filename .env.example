# ==============================================================================
# ATHANG IMPEX AI Chatbot Platform — Environment Variables Example
# Copy this file to .env locally or enter these variables in Vercel Project Settings.
# DO NOT COMMIT REAL SECRETS OR DATABASE PASSWORDS TO GITHUB.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONNECTIONS (REQUIRED FOR PRISMA RUNTIME & MIGRATIONS)
# Retrieve from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# ------------------------------------------------------------------------------

# Transaction Mode Pooler (Port 6543, pgbouncer=true) — REQUIRED for Vercel serverless runtime
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Mode Pooler / Direct Connection (Port 5432) — REQUIRED for running Prisma migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT API KEYS (OPTIONAL / REFERENCE)
# Retrieve from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Project URL (https://[YOUR-PROJECT-REF].supabase.co)
SUPABASE_URL=""

# Project Publishable API Key (anon/public)
SUPABASE_ANON_KEY=""

# Project Service Role Secret Key (OPTIONAL — Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (REQUIRED)
# ------------------------------------------------------------------------------
# 32+ character random secret used for signing admin JWT session tokens
JWT_SECRET=""

# 64-character hex string (32 bytes) for AES-256-GCM encryption of channel tokens & AI keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=""

# ------------------------------------------------------------------------------
# 4. CANONICAL APPLICATION DOMAIN (REQUIRED)
# ------------------------------------------------------------------------------
APP_BASE_URL="https://athangimpexbot.vercel.app"

# ------------------------------------------------------------------------------
# 5. INITIAL ADMINISTRATOR BOOTSTRAP (OPTIONAL — Defaults apply if omitted)
# ------------------------------------------------------------------------------
ADMIN_DEFAULT_EMAIL="admin@platform.local"
ADMIN_DEFAULT_PASSWORD="AdminPassword123!"
ADMIN_DEFAULT_NAME="Platform Owner"

# Rate limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SEC=900

# ------------------------------------------------------------------------------
# 6. AI PROVIDERS & CHANNELS (OPTIONAL — Can also be configured via Web Dashboard)
# ------------------------------------------------------------------------------
# GROQ_API_KEY=""
# MISTRAL_API_KEY=""
# GEMINI_API_KEY=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_WABA_ID=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_APP_SECRET=""
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME=""
# TELEGRAM_SECRET_TOKEN=""
